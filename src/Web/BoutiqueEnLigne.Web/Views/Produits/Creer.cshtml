@model BoutiqueEnLigne.Web.Models.Produit

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Ajouter un produit";
}

<div class="container mt-5">
    <h2>Ajouter un nouveau produit</h2>
    <form asp-action="Creer" method="post">
        <div class="mb-3">
            <label asp-for="Nom" class="form-label">Nom</label>
            <input asp-for="Nom" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Prix" class="form-label">Prix</label>
            <input asp-for="Prix" type="number" step="0.01" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label">URL de l'image</label>
            <input asp-for="ImageUrl" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Créer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </form>
</div>
