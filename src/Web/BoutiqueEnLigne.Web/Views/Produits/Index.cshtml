@model IEnumerable<BoutiqueEnLigne.Web.Models.Produit>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Nos Produits";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Catalogue de Produits</h2>
    <p class="text-center text-muted small">
        Source de donnees : @(ViewBag.DataSource == "api" ? "backend API" : "base locale")
    </p>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Rechercher un produit..." value="@ViewBag.Search" />
            <button type="submit" class="btn btn-primary">Rechercher</button>
        </div>
    </form>

    <div class="row">
        @foreach (var produit in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@produit.UrlImage" class="card-img-top" alt="@produit.Nom" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@produit.Nom</h5>
                        <p class="text-muted mb-1"><small>Catégorie : @produit.CategorieNom</small></p>
                        <p class="card-text flex-grow-1">@produit.Description</p>
                        <p class="fw-bold">@produit.Prix.ToString("C")</p>
                        <a asp-action="Details" asp-route-id="@produit.Id" class="btn btn-outline-primary mt-auto">Voir détails</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
